{
  "name": "Sprout Design System",
  "version": "2.0.0",
  "color": {
    "brand": {
      "forestPrimary": "#11382B",
      "forestLight": "#1B4D3E",
      "forestDeep": "#0A241B",
      "creamBackground": "#FDFBF7",
      "creamSurface": "#F6F1EA",
      "surfaceWhite": "#FFFFFF",
      "marigoldAccent": "#D97706",
      "marigoldDark": "#92400E",
      "marigoldSubtle": "#FEF3C7"
    },
    "neutral": {
      "textPrimary": "#18221D",
      "textSecondary": "#3F4E46",
      "textMuted": "#55655D",
      "borderSubtle": "#E5DFD7",
      "borderDefault": "#D1C9BE",
      "borderStrong": "#8B9890"
    },
    "feedback": {
      "successText": "#166534",
      "successBg": "#F0FDF4",
      "successBorder": "#86EFAC",
      "warningText": "#9C3218",
      "warningBg": "#FDF1EE",
      "warningBorder": "#FCA5A5",
      "infoText": "#075985",
      "infoBg": "#F0F9FF",
      "infoBorder": "#BAE6FD"
    }
  },
  "typography": {
    "fontFamily": {
      "heading": "Charter, 'Bitstream Charter', 'Sitka Text', Cambria, 'Noto Serif Devanagari', serif",
      "body": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans Devanagari', sans-serif",
      "mono": "ui-monospace, 'SFMono-Regular', Consolas, monospace"
    },
    "fontSize": {
      "caption": "12px",
      "disclaimer": "13px",
      "bodySmall": "14px",
      "body": "16px",
      "bodyLead": "18px",
      "h4": "20px",
      "h3": "24px",
      "h2": "32px",
      "h1": "44px"
    },
    "lineHeight": {
      "tight": "1.2",
      "snug": "1.35",
      "normal": "1.55",
      "relaxed": "1.65"
    },
    "fontWeight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "borderRadius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "touchTarget": {
    "minSize": "44px"
  },
  "disclaimer": {
    "minFontSize": "12px",
    "currentFontSize": "13px",
    "visibilityRule": "Visible without scrolling in first viewport on all investment-content views"
  }
}
